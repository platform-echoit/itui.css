{
  "name": "@echoit/itui.css",
  "description": "React component library built on Tailwind CSS v4 tokens. ESM-only, tree-shakable, TypeScript-first.",
  "version": "1.0.10",
  "publishConfig": {
    "access": "public"
  },
  "author": "echoit <echoit.dev.04@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-echoit/itui.css.git"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/ITUI/index.d.ts",
      "import": "./dist/icons/ITUI/index.js"
    },
    "./dist/index.css": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./src/styles/global.css": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:generate": "tsx scripts/test-generate.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "check:docs": "tsx scripts/generate-api-docs.ts --check",
    "check:client": "tsx scripts/check-client-boundary.ts",
    "check:rsc": "tsx scripts/check-rsc.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "prebuild": "pnpm check:client",
    "build": "pnpm build:js && pnpm build:dts && pnpm build:paths",
    "dev": "tsup --watch",
    "build:js": "tsup",
    "build:dts": "tsc -p tsconfig.components.json && tsx scripts/build-icon-types.ts",
    "build:paths": "tsx scripts/fix-esm-paths.ts",
    "build:css": "cpy src/styles/global.css dist/styles/global.css",
    "check:package": "pnpm pack && npm publish --dry-run",
    "publish:beta": "pnpm build && npm publish --tag beta --access public",
    "publish:latest": "pnpm build && npm publish --access public",
    "npm:set-token": "npm config set //registry.npmjs.org/:_authToken=$NPM_TOKEN"
  },
  "type": "module",
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@lexical/link": "^0.48.0",
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lexical/selection": "^0.48.0",
    "@lexical/utils": "^0.48.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.48.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.3",
    "cpy-cli": "^7.0.0",
    "tailwindcss": "4.2.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
